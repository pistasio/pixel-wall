# Non-secret settings only. Never put passwords, organizer keys, or API tokens here.
# Inject ADMIN_KEY through the hosting provider's secret store (32+ random characters).
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
DATA_DIR=/app/data
